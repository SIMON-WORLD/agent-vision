# 免费视觉方案：智谱 GLM-4V-Flash（永久免费）
# 注册：https://open.bigmodel.cn/ ，创建 API Key 后填入下面
VISION_API_KEY=

# 视觉模型服务地址与模型名（OpenAI 兼容）
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash

